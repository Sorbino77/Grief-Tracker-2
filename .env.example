# Copy this to `.env` and fill in real values. Never commit `.env`.

# --- Django ---
DJANGO_SECRET_KEY=replace-me-with-50-random-bytes
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8080

# Set these to True ONLY when serving over HTTPS (production).
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_SECURE_HSTS_SECONDS=0

# --- Database (PostgreSQL) ---
USE_POSTGRES=True
POSTGRES_DB=shiptrack
POSTGRES_USER=shiptrack
POSTGRES_PASSWORD=please-change-me
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_SSLMODE=prefer

# --- Cache ---
REDIS_URL=redis://redis:6379/0

# --- Auth lockout ---
AXES_FAILURE_LIMIT=5
AXES_COOLOFF_TIME=1   # hours

# --- Optional: bootstrap superuser on first deploy ---
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=ChangeMe-very-strong-12chars

# --- Optional: import a sample spreadsheet from /app/sample_data on first boot ---
# SEED_SAMPLE_DATA=1

# --- Optional: SSO ---
OAUTH_GOOGLE_ENABLED=False
OAUTH_MICROSOFT_ENABLED=False
MICROSOFT_TENANT=common
